# RealTimeChat .env Example

# Server Configuration
PORT=4000
NODE_ENV=development

# Security
# Run 'node -e "console.log(require(\'crypto\').randomBytes(32).toString(\'hex\'))"' to generate a strong secret
JWT_SECRET=your_super_secret_jwt_key_here

# CORS
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:4000

# MongoDB Configuration
# Use Standard Connection String if you experience SRV resolution issues
MONGODB_URL=mongodb://username:password@cluster-shard-00-00.mongodb.net:27017,cluster-shard-00-01.mongodb.net:27017,cluster-shard-00-02.mongodb.net:27017/chatapp?ssl=true&replicaSet=atlas-shard-0&authSource=admin&retryWrites=true&w=majority

# Firebase Admin SDK Configuration
# These are used to initialize firebase-admin / firestore
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
# Note: Private key contains newlines. Wrap in quotes if needed.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_CLIENT_ID=your-client-id

# Azure Blob Storage Configuration
AZURE_ACCOUNT_NAME=your_azure_account_name
AZURE_ACCOUNT_KEY=your_azure_account_key

# Google Drive API Configuration
# Folder IDs for different attachment types
DOCUMENTS_ID=your_gdrive_folder_id_for_documents
IMAGE_ID=your_gdrive_folder_id_for_images
VIDEO_ID=your_gdrive_folder_id_for_videos
